NODE_ENV=production
HOST=0.0.0.0
PORT=8787

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_VECTOR_STORE_ID=

ALLOWED_ORIGINS=https://acton.guide,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW=1 minute

MAX_QUESTION_CHARS=6000
MAX_CONTEXT_CHARS=12000
MAX_HISTORY_MESSAGES=8

PLAYGROUND_HOST=0.0.0.0
PLAYGROUND_PORT=8788
PLAYGROUND_ALLOWED_ORIGINS=https://play.acton.guide,https://acton.guide,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8788,http://127.0.0.1:8788
PLAYGROUND_RATE_LIMIT_MAX=10
PLAYGROUND_RATE_LIMIT_WINDOW=1 minute
PLAYGROUND_MAX_CODE_CHARS=12000
PLAYGROUND_MAX_STDIN_CHARS=4000
PLAYGROUND_MAX_OUTPUT_CHARS=20000
PLAYGROUND_TIMEOUT_SECONDS=15
PLAYGROUND_MAX_CONCURRENT_RUNS=10
PLAYGROUND_WORKSPACE_ROOT=/var/lib/ask-acton/playground
PLAYGROUND_CACHE_ROOT=/var/lib/ask-acton/cache
PLAYGROUND_DOCKER_BIN=docker
PLAYGROUND_ACTON_IMAGE=ask-acton/acton-runner:tip
PLAYGROUND_CPU_LIMIT=2
PLAYGROUND_MEMORY_LIMIT=3g
PLAYGROUND_PIDS_LIMIT=128
